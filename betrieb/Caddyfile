# Der einzige Auftritt. TLS holt Caddy selbst bei Let's Encrypt — Voraussetzung
# ist, dass der A-Record schon auf diese Maschine zeigt und 80 offen ist.

socos.test.sopharmis.com {
	encode zstd gzip

	# `socos` ist der Alias der Anwendung im proxy-netz (siehe anwendung.yml).
	#
	# Hier wird die Client-Adresse bewusst **nicht** selbst gesetzt.
	#
	# Caddy steht als erster Sprung direkt am Internet und hat kein
	# `trusted_proxies`; in dem Fall verwirft es eine vom Anrufer
	# mitgeschickte Adresse und trägt nur dessen echte ein. Genau das braucht
	# django-axes — Caddy warnt beim Reload sogar, wenn man nachhilft.
	#
	# Es wäre zudem eine Falle für später: So ein Eingriff wird nach dieser
	# Logik angewandt und gewinnt gegen sie. Käme je ein CDN davor,
	# überschriebe er jede echte Client-Adresse mit der des CDN — und dann
	# sperrte ein einziger Angreifer alle Nutzer gleichzeitig aus.
	#
	# Ausführlich in SERVER.md, festgehalten in socos/tests/test_axes.py.
	# Höchstens 13 MB je Anfrage — eine Datei bis 12 MB samt Formularhülle
	# (siehe ANHANG_HOECHSTENS in socos/api.py). Ohne Grenze kann jeder,
	# auch ohne Anmeldung, den Server mit einer riesigen Anfrage beschäftigen.
	#
	# Ausgenommen ist allein das Einspielen einer Sicherung: Das Archiv
	# enthält alle Anhänge und wächst mit ihnen. Eine Grenze dort fiele
	# erst auf, wenn man die Sicherung braucht. Der Weg steht nur einem
	# Admin offen (`darf_sichern`).
	@begrenzt not path /api/sicherung/einspielen/
	request_body @begrenzt {
		max_size 13MB
	}

	reverse_proxy socos:8000

	log {
		output stdout
	}
}
