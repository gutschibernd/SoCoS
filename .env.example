# Vorlage. Die echte .env liegt nur am Server bzw. lokal und wird nie committet.

# Zufallswert, mind. 50 Zeichen. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=hier-einen-zufallswert-einsetzen

# 1 nur lokal. Am Server immer 0.
DJANGO_DEBUG=1

# Kommagetrennt, ohne Schema. Am Server: socos.sopharmis.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Volle URL(s) mit Schema, nur am Server nötig.
DJANGO_CSRF_TRUSTED_ORIGINS=https://socos.sopharmis.com

# Datenbank
POSTGRES_DB=socos
POSTGRES_USER=socos
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Lokale Ports. 8000/5173 und 8001/5174 gehören zwei anderen Projekten auf
# derselben Maschine — hier nie verwenden.
DJANGO_PORT=8003
PORT=5176
